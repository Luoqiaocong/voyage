# ─────────────────────────────────────────────────────────────
# Voyage 后端环境变量样例
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会入库）
# ─────────────────────────────────────────────────────────────

# ---------- LLM 通道：OpenCode Go（当前唯一可用通道，OpenAI 兼容）----------
OPENCODE_GO_URL = https://opencode.ai/zen/go/v1
OPENCODE_API_KEY = YOUR_OPENCODE_API_KEY
OPENCODE_LLM_MODEL = deepseek-v4.1-flash
# 未显式声明会话时使用的兜底会话标识（网关要求每个请求带 x-opencode-session）
OPENCODE_DEFAULT_SESSION = voyage-anonymous
CLIENT_USER_AGENT = voyage-travel-assistant/1.0
# 统计与展示用的本地时区（影响「今日用量」的跨日口径）
APP_TIMEZONE = Asia/Shanghai

# ---------- 数据库 ----------
# 本地开发：留空则回退到 SQLite（data/exports/app.db），
# 不必为了跑一个测试先装一套 PG。
# 本地想连 PostgreSQL：填下面这行（asyncpg 驱动，异步）。
#
# ⚠️ **Docker 部署时这一项会被 docker-compose.yml 覆盖**，
#    后端自动连 compose 内的 postgres 服务，无需在这里配置。
#    只有想用**外部** PostgreSQL 时，才需要填这里并注释掉 compose 中的覆盖行。
#
# 托管服务（Neon / Supabase 等）一般要求 TLS，加 ?ssl=require。
# 注意：会话消息状态（langgraph checkpointer）会落在**同一个库**里，
# 但用的是 psycopg 驱动，由本项自动推导，无需单独配置。
# DATABASE_URL = postgresql+asyncpg://user:password@host:5432/dbname?ssl=require
# 可选：想让 checkpointer 用另一个库时单独指定（psycopg 形式，不带 +asyncpg）
# CHECKPOINT_DATABASE_URL = postgresql://user:password@host:5432/dbname?sslmode=require

# ---------- Docker 内置 PostgreSQL ----------
# 仅在使用 docker compose 部署时生效（本地直跑后端用不到）。
# 不设置则用默认值 voyage，仅在内网可达；生产环境建议覆盖密码。
# POSTGRES_USER = voyage
# POSTGRES_PASSWORD = 换成强密码
# POSTGRES_DB = voyage

# ---------- 部署相关 ----------
# 分享链接的对外基址：分享接口返回的 url 由它 + /share/{token} 拼成。
# 部署到服务器时务必改成实际可访问地址，否则分享出去的链接点不开。
SHARE_BASE_URL = http://localhost:5173

# 跨域白名单（JSON 数组）。留空 = 允许所有来源（开发便利）。
# 同源部署（nginx 把 /api 反代到后端）时无需配置。
# ALLOWED_ORIGINS = ["https://your-domain.com"]

# ---------- 历史通道（DashScope 免费额度已耗尽，保留仅供回退/对比）----------
DASHSCOPE_BASE_URL = https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL = https://api.deepseek.com
ALIYUN_BASE_URL = https://ws-llq8baw8q88n1gjz.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY = YOUR_DASHSCOPE_API_KEY
DEEPSEEK_API_KEY = YOUR_DEEPSEEK_API_KEY

# ---------- 历史模型配置 ----------
ALIYUN_LLM_MODEL = qwen3-max
DEEPSEEK_LLM_MODEL_FLASH = deepseek-v4-flash
DEEPSEEK_LLM_MODEL_PRO = deepseek-v4-pro

# ---------- JWT 与哈希 ----------
# 密钥可生成网站：https://motools.net/zh/dev/secret-key-generator
JWT_SECRET_KEY = YOUR_JWT_SECRET_KEY
JWT_ALGORITHM = HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 30
JWT_REFRESH_TOKEN_EXPIRE_DAYS = 7
HASH_SALT = YOUR_HASH_SALT

# ---------- Redis（限流、验证码、Refresh Token、Token 用量统计）----------
# 建议 Redis >= 7；计数原语已改用 Lua 脚本以兼容 5.x / 6.x。
REDIS_URL = redis://127.0.0.1:6379/7
REDIS_HOST = localhost
REDIS_PORT = 6379
REDIS_DB = 7

# ---------- 邮件（默认 Resend；切换供应商只需改这几项）----------
RESEND_API_KEY = YOUR_RESEND_API_KEY
MAIL_FROM_NAME = Voyage
MAIL_FROM_ADDRESS = noreply@example.com
SMTP_HOST = smtp.resend.com
SMTP_PORT = 587
SMTP_USER = resend

# ---------- 日志 ----------
LOG_LEVEL = INFO
LOG_TO_FILE = false
LOG_SAVE_PATH = logs
