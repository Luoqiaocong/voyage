# ============================================================================
# 后端镜像构建上下文排除清单
#
# 最重要的两条：
#   .env   —— 含全部密钥，绝不能进镜像层（镜像可被导出，等于泄露）
#   data/  —— 本机数据库与日志，会被 COPY 进镜像并覆盖容器内数据
# ============================================================================

# ---- 密钥与本地配置 ----
.env
.env.*
!.env.example

# ---- 运行时数据（挂载卷，不打进镜像）----
data/
!data/.gitkeep

# ---- 前端源码 ----
# 后端镜像不含前端产物（前端由 web/Dockerfile 单独构建并托管）。
# 排除整个 web/ 可省掉 node_modules（约 68MB）与源码的传输。
web/

# ---- Python 虚拟环境与缓存 ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/

# ---- 版本控制与编辑器 ----
.git/
.gitignore
.github/
.vscode/
.idea/
*.swp

# ---- 文档与本地脚本 ----
*.md
!README.md
tests/
.dsh_*
.preview/
.shots/
